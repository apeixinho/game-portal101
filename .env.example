# Cross-app URL overrides (Vite)

# Set in each Vercel project (Production + Preview) or locally in apps/<app>/.env.
# See docs/deploy-vercel.md.

# Hub → child apps
VITE_PUBLIC_URL_ARRAIAL_DIGITAL=
VITE_PUBLIC_URL_ARRAIAL_MATEMATICA=
VITE_PUBLIC_URL_CARACOIS=

# Optional deferred planets (still link to originals until ported)
VITE_PUBLIC_URL_DESCOBRIMENTOS=
VITE_PUBLIC_URL_ARRAIAL_3D=
VITE_PUBLIC_URL_EXPEDICAO=
VITE_PUBLIC_URL_ESTUDIO_HARDWARE=
VITE_PUBLIC_URL_AIBOT=

# Child apps → Hub
VITE_PUBLIC_URL_HUB=

# Later: realtime relay on Render (unused until an online mode ships)
# VITE_REALTIME_URL=
